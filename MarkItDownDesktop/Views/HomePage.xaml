<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MarkItDownDesktop.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Padding="40,36,40,48" Spacing="28">
            <StackPanel Spacing="8">
                <TextBlock Text="MarkItDown" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="将文档快速转换为干净的 Markdown" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="15" />
            </StackPanel>
            <InfoBar x:Name="ConversionInfo" IsOpen="False" Severity="Informational" Title="转换功能即将推出" Message="下一阶段将接入 MarkItDown CLI。当前不会生成文件。" />
            <Border x:Name="DropZone" MinHeight="304" Padding="28" CornerRadius="18" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop" PointerEntered="DropZone_PointerEntered" PointerExited="DropZone_PointerExited">
                <Grid>
                    <StackPanel x:Name="EmptyContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="13">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                            <SymbolIcon Symbol="OpenFile" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="拖放文件到这里" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="支持 PDF、Word、PowerPoint、Excel 等格式" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="选择文件" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" Click="ChooseFile_Click" />
                        <TextBlock Text="或将文件直接拖入此区域" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="SelectedContent" Visibility="Collapsed" VerticalAlignment="Center" Spacing="22">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <SymbolIcon Symbol="Document" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="FileNameText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="FileDetailsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Padding="14,12" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="输出" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="OutputNameText" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="更换文件" Click="ChooseFile_Click" />
                            <Button x:Name="ConvertButton" Content="开始转换" Style="{StaticResource AccentButtonStyle}" Click="Convert_Click" />
                        </StackPanel>
                        <ProgressBar x:Name="ConversionProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Spacing="16">
                <TextBlock Text="最近转换" FontSize="20" FontWeight="SemiBold" />
                <Border x:Name="RecentEmpty" Padding="24" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,16">
                        <SymbolIcon Symbol="Clock" HorizontalAlignment="Center" />
                        <TextBlock Text="还没有转换记录" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="完成转换后，最近的文件会显示在这里" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <ListView x:Name="RecentList" Visibility="Collapsed" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3"><TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding OutputName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Time}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
