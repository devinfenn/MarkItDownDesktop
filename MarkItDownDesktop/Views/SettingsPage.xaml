<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MarkItDownDesktop.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Padding="40,36,40,48" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="设置" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="调整输出与应用体验" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock Text="输出" FontSize="20" FontWeight="SemiBold" />
                <Border Padding="20" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4"><TextBlock Text="默认输出位置" FontWeight="SemiBold" /><TextBlock Text="选择 Markdown 文件的保存位置" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                            <ComboBox x:Name="OutputLocation" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OutputLocation_SelectionChanged">
                                <ComboBoxItem Content="与原文件相同目录" /><ComboBoxItem Content="自定义目录" />
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="CustomFolderRow" Visibility="Collapsed" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomFolderPath" PlaceholderText="选择输出目录" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="浏览…" Click="BrowseFolder_Click" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="自动打开生成的 Markdown" VerticalAlignment="Center" /><ToggleSwitch x:Name="OpenAfterToggle" Grid.Column="1" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="在文件资源管理器中显示" VerticalAlignment="Center" /><ToggleSwitch x:Name="ShowFolderToggle" Grid.Column="1" /></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold" />
                <Border Padding="20" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="应用主题" FontWeight="SemiBold" /><TextBlock Text="选择喜欢的显示模式" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        <ComboBox x:Name="ThemePicker" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ThemePicker_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock Text="MarkItDown" FontSize="20" FontWeight="SemiBold" />
                <Border Padding="20" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="MarkItDown 状态" FontWeight="SemiBold" /><TextBlock x:Name="CliStatusText" Grid.Column="1" Text="未检测" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><TextBlock Text="可执行命令" VerticalAlignment="Center" /><TextBox x:Name="CommandText" Grid.Column="1" Text="markitdown" /></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
