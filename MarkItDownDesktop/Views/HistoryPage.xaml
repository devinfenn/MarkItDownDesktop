<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MarkItDownDesktop.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Padding="40,36,40,48" Spacing="26">
            <StackPanel Spacing="8">
                <TextBlock Text="历史记录" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="查看最近转换的文档" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索文件名" QueryIcon="Find" TextChanged="Filter_Changed" />
                <ComboBox x:Name="TypeFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="TypeFilter_Changed">
                    <ComboBoxItem Content="全部类型" /><ComboBoxItem Content="PDF" /><ComboBoxItem Content="Word" /><ComboBoxItem Content="PPT" /><ComboBoxItem Content="Excel" />
                </ComboBox>
            </Grid>
            <Border x:Name="HistoryEmpty" Padding="32" MinHeight="260" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <SymbolIcon Symbol="Clock" HorizontalAlignment="Center" />
                    <TextBlock Text="还没有转换记录" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="完成转换后，可在这里搜索和查看文件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ListView x:Name="HistoryList" Visibility="Collapsed" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="135" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding OutputName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Time}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Column="2" Content="打开文件" Tag="{Binding}" Click="OpenFile_Click" />
                            <Button Grid.Column="3" Content="打开文件夹" Tag="{Binding}" Click="OpenFolder_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
